# Copy this file to .env and fill in real values. Never commit the real .env file.

PORT=4000

# Resend API key (resend.com -> API Keys)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Inbox that receives contact-form messages.
# While using onboarding@resend.dev as the sender, this MUST be the same
# email you signed up to Resend with.
CONTACT_TO_EMAIL=izzuddinazmi130@gmail.com

# Optional. Leave blank to use Resend's test sender (onboarding@resend.dev).
# Once you verify your own domain in Resend, set e.g.:
# CONTACT_FROM_EMAIL=Portfolio Contact <contact@yourdomain.com>
CONTACT_FROM_EMAIL=

# Simple shared-secret token you invent yourself, used to protect the
# add/update/delete project endpoints. Send it as header: x-admin-token
ADMIN_TOKEN=change-this-to-a-long-random-string

# Comma-separated list of origins allowed to call this API (your frontend URL(s))
CLIENT_ORIGIN=http://localhost:5173
