# Copy this file to .env and fill in real values. Never commit the real .env file.

PORT=4000

# Where contact-form submissions get emailed to
CONTACT_TO_EMAIL=izzuddinazmi130@gmail.com

# SMTP credentials used to SEND that email (Gmail example below - see README for setup)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASS=your-16-character-app-password

# Simple shared-secret token you invent yourself, used to protect the
# add/update/delete project endpoints. Send it as header: x-admin-token
ADMIN_TOKEN=change-this-to-a-long-random-string

# Comma-separated list of origins allowed to call this API (your frontend URL(s))
CLIENT_ORIGIN=http://localhost:5173
